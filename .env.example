# Copy to .env and fill in real values. Never commit .env.

# Supabase connection strings.
# Passwords containing reserved characters (@ : / ? #) must be percent-encoded.
#
# DATABASE_URL — transaction pooler (port 6543), used by the app at runtime.
# DIRECT_URL   — session pooler (port 5432), used by `prisma migrate`.
#
# The `db.<PROJECT_REF>.supabase.co` direct host is IPv6-only on current
# Supabase projects; use the pooler hostnames on IPv4-only networks.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Signing key for the session cookie. Generate with: openssl rand -base64 48
AUTH_SECRET=""

# Bootstrap data created by `npm run db:seed`.
SEED_ORGANIZATION_NAME="Matesther"
SEED_OWNER_EMAIL="owner@matesther.local"
SEED_OWNER_PASSWORD=""
